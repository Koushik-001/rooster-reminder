{
  "expo": {
    "name": "rooster-reminder",
    "slug": "rooster-reminder",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-router",
      "expo-notifications"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chavakoushik.roosterreminder",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chavakoushik.roosterreminder"
    },
    "extra": {
      "eas": {
        "projectId": "e783285c-2c74-4138-89f4-22fdbba81c23"
      }
    },
    "owner": "chava-koushik",
    "updates": {
      "url": "https://u.expo.dev/e783285c-2c74-4138-89f4-22fdbba81c23"
    }
  }
}
